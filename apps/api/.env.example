# ---------- هستهٔ سرور ----------
PORT=3001
NODE_ENV=development
# حداقل ۳۲ نویسهٔ تصادفی (در production اجباری است): openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
DATABASE_PATH=./data/boshghabyar.db
# پشت nginx/Cloudflare مقدار loopback یا تعداد پراکسی؛ بدون پراکسی false
TRUST_PROXY=false
APP_TIMEZONE=Asia/Tehran
SESSION_DAYS=30

# ---------- حساب مدیر ----------
ADMIN_EMAIL=admin@boshghabyar.ir
# اگر تنظیم شود، رمز مدیر در هر راه‌اندازی با این مقدار هماهنگ می‌شود
ADMIN_PASSWORD=

# ---------- ورود با کد پیامکی ----------
# console = فقط توسعه/پایلوت (کد در لاگ سرور)، kavenegar = ارسال واقعی پیامک
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=boshghabyar-otp
# فقط برای پایلوت بدون پنل پیامک: کد ورود در پاسخ API برگردانده می‌شود (ناامن برای محیط واقعی)
OTP_DEBUG_RETURN_CODE=false

# ---------- حالت آزمایشی ----------
ENABLE_DEMO=true
# ارتقای آزمایشی (بدون پرداخت). در محیط واقعی false بماند تا درگاه پرداخت وصل شود
ALLOW_MOCK_UPGRADE=false

# ---------- تشخیص غذا با عکس ----------
# none | openai | anthropic | mock (mock فقط تست؛ نتیجه واقعی نیست)
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=15000
MAX_IMAGE_BYTES=4194304

# ---------- پژوهش ----------
# کلید شبه‌ناشناس‌سازی شناسهٔ کاربران در خروجی پژوهشی؛ با تغییر آن، شناسه‌ها عوض می‌شوند
RESEARCH_SECRET=
